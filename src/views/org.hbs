{{!< layout}}
<p class="crumb"><a href="/orgs">Organizations</a> &rsaquo; {{organization.name}}</p>
<h1>{{organization.name}}</h1>
<p class="sub">You are {{#if isAdmin}}an admin{{else}}a member{{/if}} of this organization.</p>
{{#if error}}<div class="alert">{{error}}</div>{{/if}}

<div class="card">
  <h2>Projects</h2>
  {{#if projects.length}}
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Project</th>
            <th class="num">Budget (ETB)</th>
            <th class="num">Spent (ETB)</th>
            <th class="num">Remaining</th>
            <th class="num">Tasks</th>
          </tr>
        </thead>
        <tbody>
        {{#each projects}}
          <tr>
            <td>
              <a href="/orgs/{{../organization.id}}/projects/{{this.id}}">{{this.name}}</a>
              <div class="meter {{#if this.isOverBudget}}over{{/if}}"><span style="width:{{this.percentUsed}}%"></span></div>
            </td>
            <td class="num">{{this.budgetFormatted}}</td>
            <td class="num">{{this.spentFormatted}}</td>
            <td class="num {{#if this.isOverBudget}}over{{/if}}">{{this.remainingFormatted}}</td>
            <td class="num">{{this.taskCount}}</td>
          </tr>
        {{/each}}
        </tbody>
      </table>
    </div>
  {{else}}
    <p class="empty">No projects yet.</p>
  {{/if}}
</div>

{{#if isAdmin}}
<div class="card">
  <h2>New project</h2>
  <form method="post" action="/orgs/{{organization.id}}/projects" class="inline-form">
    <div class="field">
      <label for="p-name">Name</label>
      <input id="p-name" name="name" required>
    </div>
    <div class="field">
      <label for="p-desc">Description</label>
      <input id="p-desc" name="description" placeholder="Optional">
    </div>
    <div class="field field-md">
      <label for="p-budget">Budget (ETB)</label>
      <input id="p-budget" name="budgetEtb" type="number" min="0" step="0.01" value="0" required>
    </div>
    <button type="submit">Add project</button>
  </form>
</div>
{{/if}}

<div class="card">
  <h2>Members</h2>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Name</th><th>Email</th><th>Role</th>{{#if isAdmin}}<th></th>{{/if}}</tr></thead>
      <tbody>
      {{#each members}}
        <tr>
          <td>{{this.name}}</td>
          <td class="muted">{{this.email}}</td>
          <td><span class="pill {{#unless this.isAdmin}}muted{{/unless}}">{{this.role}}</span></td>
          {{#if ../isAdmin}}
            <td>
              <div class="actions">
                {{#unless this.isLastAdmin}}
                  <form method="post" action="/orgs/{{../organization.id}}/members/{{this.userId}}/delete">
                    <button class="danger" type="submit">Remove</button>
                  </form>
                {{else}}
                  <span class="muted" style="font-size:12px">Only admin</span>
                {{/unless}}
              </div>
            </td>
          {{/if}}
        </tr>
      {{/each}}
      </tbody>
    </table>
  </div>

  {{#if isAdmin}}
    <form method="post" action="/orgs/{{organization.id}}/invitations" class="inline-form" style="margin-top:18px">
      <div class="field">
        <label for="m-email">Invite someone by email</label>
        <input id="m-email" name="email" type="email" placeholder="name@example.com" required>
      </div>
      <div class="field field-sm">
        <label for="m-role">Role</label>
        <select id="m-role" name="role">
          <option value="member">member</option>
          <option value="admin">admin</option>
        </select>
      </div>
      <button type="submit">Send invitation</button>
    </form>
    <p class="note">
      Registered users are added right away. Anyone else receives an email invitation and creates their
      account when they accept.
    </p>
  {{/if}}
</div>

{{#if isAdmin}}
  {{#if pendingInvitations.length}}
  <div class="card">
    <h2>Pending invitations</h2>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Email</th><th>Role</th><th>Expires</th><th></th></tr></thead>
        <tbody>
        {{#each pendingInvitations}}
          <tr>
            <td>{{this.email}}</td>
            <td><span class="pill muted">{{this.role}}</span></td>
            <td class="muted">{{this.expiresAt}}</td>
            <td>
              <div class="actions">
                <form method="post" action="/orgs/{{../organization.id}}/invitations/{{this.id}}/delete">
                  <button class="danger" type="submit">Revoke</button>
                </form>
              </div>
            </td>
          </tr>
        {{/each}}
        </tbody>
      </table>
    </div>
  </div>
  {{/if}}
{{/if}}
