<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<title>{{#if title}}{{title}} &middot; {{/if}}Project Tracker</title>
<style>
  :root {
    --bg: #f6f7f9;
    --surface: #ffffff;
    --sunken: #fafbfc;
    --border: #e3e6ea;
    --border-strong: #d4d9df;
    --text: #1d2127;
    --muted: #6b727d;
    --accent: #2f6f4f;
    --accent-strong: #26593f;
    --accent-soft: #e8f2ec;
    --accent-line: #cfe4d8;
    --danger: #a4342c;
    --danger-soft: #fbeceb;
    --danger-line: #f0cfcc;
    --radius: 10px;
    --radius-sm: 7px;
    --shadow: 0 1px 2px rgba(16, 24, 40, 0.04);
    --ring: 0 0 0 3px rgba(47, 111, 79, 0.15);
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font: 15px/1.55 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  a { color: var(--accent); text-decoration: none; }
  a:hover { text-decoration: underline; }
  a:focus-visible, button:focus-visible, .btn:focus-visible {
    outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 4px;
  }

  .topbar {
    position: sticky; top: 0; z-index: 20;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    padding: 0 20px;
  }
  .topbar-inner {
    max-width: 960px; margin: 0 auto;
    display: flex; align-items: center; gap: 14px; min-height: 56px; flex-wrap: wrap;
  }
  .brand { font-weight: 650; letter-spacing: -0.01em; color: var(--text); }
  .brand:hover { text-decoration: none; opacity: 0.75; }
  .spacer { margin-left: auto; }
  .navlink { color: var(--muted); font-size: 13px; }
  .navlink:hover { color: var(--text); text-decoration: none; }
  .who { color: var(--muted); font-size: 13px; }

  main { max-width: 960px; margin: 0 auto; padding: 28px 20px 64px; }
  h1 { font-size: 22px; margin: 0 0 4px; letter-spacing: -0.015em; }
  h2 {
    font-size: 12px; font-weight: 650; text-transform: uppercase; letter-spacing: 0.06em;
    color: var(--muted); margin: 0 0 14px;
  }
  .sub { color: var(--muted); margin: 0 0 22px; font-size: 14px; }
  .crumb { font-size: 13px; color: var(--muted); margin: 0 0 14px; }
  .crumb a { color: var(--muted); }
  .crumb a:hover { color: var(--text); text-decoration: none; }

  .card {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--radius); padding: 18px; margin-bottom: 16px;
    box-shadow: var(--shadow);
  }
  .row { display: flex; gap: 16px; align-items: flex-start; flex-wrap: wrap; }
  .row > * { flex: 1 1 320px; min-width: 0; }
  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 16px; }
  .stat-label { color: var(--muted); font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; }
  .stat-value { font-size: 20px; letter-spacing: -0.015em; font-variant-numeric: tabular-nums; margin-top: 2px; }
  .stat-value.over { color: var(--danger); }
  .stat-value .unit { font-size: 13px; color: var(--muted); font-weight: 500; letter-spacing: 0; }
  .stat-value.over .unit { color: var(--danger); opacity: 0.75; }

  .table-wrap { overflow-x: auto; }
  @media (hover: hover) and (min-width: 760px) { .table-wrap { overflow: visible; } }
  .table-wrap.wide > table { min-width: 780px; }
  table { width: 100%; border-collapse: collapse; font-size: 14px; }
  th {
    text-align: left; color: var(--muted); font-weight: 600; font-size: 11px;
    text-transform: uppercase; letter-spacing: 0.05em; padding: 0 12px 8px 0; white-space: nowrap;
  }
  td { padding: 11px 12px 11px 0; border-top: 1px solid var(--border); vertical-align: middle; }
  th:last-child, td:last-child { padding-right: 0; }
  tbody tr:hover td { background: var(--sunken); }
  .num { text-align: right; font-variant-numeric: tabular-nums; }
  .over { color: var(--danger); }
  .c-status { width: 140px; }
  .c-assignee { width: 195px; }
  .c-cost { width: 170px; }
  .c-act { width: 1%; }
  td.act { width: 1%; white-space: nowrap; padding-right: 8px; }
  td.act:last-child { padding-right: 0; }
  td.act form { margin: 0; }
  .editable td { padding-top: 5px; padding-bottom: 5px; }
  td input, td select {
    border-color: transparent; background-color: transparent;
    margin-left: -10px; width: calc(100% + 10px);
  }
  td.num input { margin-left: 0; margin-right: -10px; }
  td select { width: auto; max-width: calc(100% + 10px); min-width: 0; }
  .assignee { display: flex; align-items: center; gap: 2px; }
  .assignee select { margin-left: 0; max-width: 100%; }
  .avatar {
    flex: none; width: 22px; height: 22px; border-radius: 999px;
    display: inline-flex; align-items: center; justify-content: center;
    font-size: 10px; font-weight: 650; letter-spacing: 0.02em;
    background: var(--accent-soft); color: var(--accent); border: 1px solid var(--accent-line);
  }
  .avatar.none { background: var(--sunken); color: var(--muted); border-color: var(--border); font-weight: 500; }
  td input:hover, td select:hover { border-color: var(--border-strong); background-color: var(--surface); }
  td input:focus, td select:focus { border-color: var(--accent); background-color: var(--surface); }
  tr.dirty td:first-child { box-shadow: inset 2px 0 0 var(--accent); }
  .st-todo { color: var(--muted); }
  .st-in_progress { color: #8a5a12; }
  .st-done { color: var(--accent); }

  label { display: block; font-size: 13px; color: var(--muted); margin-bottom: 5px; }
  input, select, textarea {
    width: 100%; padding: 8px 10px; font: inherit; color: inherit;
    background-color: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-sm);
    transition: border-color 0.15s ease, box-shadow 0.15s ease, background-color 0.15s ease;
  }
  select {
    appearance: none; -webkit-appearance: none; cursor: pointer; padding-right: 30px;
    background-image: url("data:image/svg+xml;charset=utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 8'%3E%3Cpath d='M1 1.75 6 6.25 11 1.75' fill='none' stroke='%236b727d' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
    background-repeat: no-repeat; background-position: right 10px center; background-size: 11px 7px;
  }
  input[type='number'] { -moz-appearance: textfield; }
  input[type='number']::-webkit-inner-spin-button,
  input[type='number']::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }
  input::placeholder { color: #a8aeb6; }
  input:hover, select:hover { border-color: var(--border-strong); }
  input:focus, select:focus, textarea:focus {
    outline: none; border-color: var(--accent); box-shadow: var(--ring);
  }
  input:disabled { background-color: var(--sunken); color: var(--muted); }
  .field { margin-bottom: 12px; }
  .inline-form { display: flex; gap: 10px; align-items: flex-end; flex-wrap: wrap; }
  .inline-form .field { margin-bottom: 0; flex: 1 1 140px; }
  .inline-form .field-sm { flex: 0 1 150px; }
  .inline-form .field-md { flex: 0 1 185px; }

  button, .btn {
    font: inherit; font-weight: 550; cursor: pointer; display: inline-block; text-decoration: none;
    padding: 8px 14px; border-radius: var(--radius-sm); border: 1px solid var(--accent);
    background: var(--accent); color: #fff; white-space: nowrap;
    transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }
  button:hover, .btn:hover { background: var(--accent-strong); border-color: var(--accent-strong); text-decoration: none; }
  button.secondary, .btn.secondary { background: var(--surface); color: var(--text); border-color: var(--border); }
  button.secondary:hover, .btn.secondary:hover { background: var(--sunken); border-color: var(--border-strong); }
  button.danger {
    background: var(--surface); color: var(--danger); border-color: var(--danger-line);
    padding: 5px 10px; font-size: 13px;
  }
  button.danger:hover { background: var(--danger-soft); border-color: var(--danger); }
  button.small, .btn.small { padding: 6px 11px; font-size: 13px; }
  button[disabled], .btn[disabled] { opacity: 0.55; cursor: progress; }
  button[disabled]:hover, .btn[disabled]:hover { background: var(--accent); border-color: var(--accent); }
  form[aria-busy='true'] input, form[aria-busy='true'] select { opacity: 0.7; pointer-events: none; }
  .is-busy-field { opacity: 0.7; pointer-events: none; }
  button.icon-btn {
    position: relative;
    width: 30px; height: 30px; padding: 0; border-radius: var(--radius-sm);
    display: inline-flex; align-items: center; justify-content: center;
    background: transparent; border: 1px solid transparent; color: var(--muted);
  }
  button.icon-btn svg { width: 15px; height: 15px; display: block; }
  button.icon-btn:hover { background: var(--sunken); border-color: var(--border); color: var(--text); }
  button.icon-btn.save:hover { background: var(--accent-soft); border-color: var(--accent-line); color: var(--accent); }
  button.icon-btn.remove:hover { background: var(--danger-soft); border-color: var(--danger-line); color: var(--danger); }
  tr.dirty button.icon-btn.save { background: var(--accent); border-color: var(--accent); color: #fff; }
  tr.dirty button.icon-btn.save:hover { background: var(--accent-strong); border-color: var(--accent-strong); color: #fff; }
  button.icon-btn[disabled], button.icon-btn[disabled]:hover {
    background: transparent; border-color: transparent; color: var(--muted);
  }
  tr.dirty button.icon-btn.save[disabled], tr.dirty button.icon-btn.save[disabled]:hover {
    background: var(--accent); border-color: var(--accent); color: #fff;
  }
  button.icon-btn.is-busy { cursor: progress; }
  button.icon-btn.is-busy > svg { visibility: hidden; }
  button.icon-btn.is-busy::after { display: none; }
  button.icon-btn.is-busy::before {
    content: ''; position: absolute; width: 13px; height: 13px; border-radius: 999px;
    border: 2px solid currentColor; border-top-color: transparent;
    animation: icon-spin 0.6s linear infinite;
  }
  @keyframes icon-spin { to { transform: rotate(360deg); } }

  .tip { position: relative; }
  .tip::after {
    content: attr(data-tip);
    position: absolute; right: -2px; bottom: calc(100% + 6px);
    background: #22262c; color: #fff; font-size: 11px; font-weight: 500; line-height: 1.5;
    padding: 3px 8px; border-radius: 5px; white-space: nowrap; pointer-events: none;
    opacity: 0; transition: opacity 0.12s ease; z-index: 30;
    box-shadow: 0 2px 8px rgba(16, 24, 40, 0.18);
  }
  .tip:hover::after, .tip:focus-visible::after { opacity: 1; }
  @media (hover: none) { .tip::after { display: none; } }
  .actions { display: flex; gap: 8px; justify-content: flex-end; align-items: center; }
  .actions form { margin: 0; }

  .pill {
    display: inline-block; padding: 3px 9px; border-radius: 999px;
    font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em;
    background: var(--accent-soft); color: var(--accent); border: 1px solid var(--accent-line);
  }
  .pill.muted { background: var(--sunken); color: var(--muted); border-color: var(--border); }

  .meter { height: 6px; border-radius: 999px; background: #e9ecef; overflow: hidden; margin-top: 8px; }
  .meter > span { display: block; height: 100%; background: var(--accent); transition: width 0.3s ease; }
  .meter.over > span { background: var(--danger); }
  .meter-row { display: flex; align-items: center; gap: 12px; margin-top: 18px; }
  .meter-row .meter { flex: 1; margin-top: 0; }
  .meter-pct { font-size: 12px; color: var(--muted); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .meter-pct.over { color: var(--danger); font-weight: 600; }
  .card-head { display: flex; align-items: center; gap: 9px; margin-bottom: 14px; }
  .card-head h2 { margin: 0; }
  .card-foot { margin-top: 18px; padding-top: 18px; border-top: 1px solid var(--border); }
  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }

  .alert {
    background: var(--danger-soft); border: 1px solid var(--danger-line); color: var(--danger);
    padding: 10px 12px; border-radius: var(--radius-sm); margin-bottom: 16px; font-size: 14px;
  }
  .empty {
    color: var(--muted); font-size: 14px; text-align: center; margin: 0;
    padding: 22px 14px; background: var(--sunken);
    border: 1px dashed var(--border-strong); border-radius: var(--radius-sm);
  }
  .muted { color: var(--muted); }
  .hint { color: var(--muted); font-size: 13px; margin: -4px 0 14px; }
  .note { color: var(--muted); font-size: 12px; margin: 14px 0 0; }
  .stack > * + * { margin-top: 12px; }
  .auth { max-width: 400px; margin: 56px auto 0; }
  .auth-foot { font-size: 14px; color: var(--muted); margin: 16px 0 0; text-align: center; }

  .toast {
    position: fixed; top: 72px; right: 16px; z-index: 50; max-width: 360px;
    display: flex; gap: 10px; align-items: flex-start;
    padding: 11px 14px; border-radius: 9px; font-size: 14px; border: 1px solid;
    box-shadow: 0 8px 28px rgba(16, 24, 40, 0.14); animation: toast-in 0.18s ease-out;
  }
  .toast.success { background: var(--accent-soft); border-color: var(--accent-line); color: var(--accent); }
  .toast.error { background: var(--danger-soft); border-color: var(--danger-line); color: var(--danger); }
  .toast-close {
    background: none; border: none; color: inherit; font-size: 18px; line-height: 1;
    padding: 0 0 0 6px; cursor: pointer;
  }
  .toast-close:hover { background: none; opacity: 0.6; }
  @keyframes toast-in { from { opacity: 0; transform: translateY(-8px); } }

  @media (max-width: 640px) {
    .topbar { padding: 0 16px; }
    main { padding: 22px 16px 48px; }
    .card { padding: 16px; }
    .auth { margin-top: 32px; }
    .toast { top: 64px; left: 16px; right: 16px; max-width: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    * { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; }
  }
</style>
</head>
<body>
<header class="topbar">
  <div class="topbar-inner">
    <a class="brand" href="/">Project Tracker</a>
    {{#if currentOrg}}<span class="pill">{{currentOrg.name}}</span>{{/if}}
    <span class="spacer"></span>
    {{#if currentUser}}
      <a class="navlink" href="/orgs">Organizations</a>
      <span class="who">{{currentUser.name}}</span>
      <form method="post" action="/logout" style="margin:0">
        <button class="secondary small" type="submit">Sign out</button>
      </form>
    {{/if}}
  </div>
</header>
{{#if flash}}
  <div class="toast {{flash.type}}" role="status" aria-live="polite">
    <span>{{flash.message}}</span>
    <button class="toast-close" type="button" aria-label="Dismiss">&times;</button>
  </div>
{{/if}}
<main>
{{{body}}}
</main>
<script>
(function () {
  function controlsOf(form) {
    return Array.prototype.slice.call(form.elements || []);
  }

  function lock(form) {
    form.setAttribute('aria-busy', 'true');

    var controls = controlsOf(form);

    controls.forEach(function (control) {
      if (control.tagName !== 'BUTTON') {
        control.classList.add('is-busy-field');
        return;
      }

      if (control.classList.contains('icon-btn')) {
        control.classList.add('is-busy');
        return;
      }

      if (!control.getAttribute('data-idle-label')) {
        control.setAttribute('data-idle-label', control.textContent);
      }
      control.textContent = 'Loading…';
    });

    window.setTimeout(function () {
      controls.forEach(function (control) {
        if (control.tagName === 'BUTTON') {
          control.disabled = true;
        }
      });
    }, 0);
  }

  function unlock(form) {
    form.removeAttribute('aria-busy');
    form.removeAttribute('data-submitting');

    controlsOf(form).forEach(function (control) {
      control.classList.remove('is-busy-field');

      if (control.tagName !== 'BUTTON') {
        return;
      }

      control.disabled = false;
      control.classList.remove('is-busy');

      var label = control.getAttribute('data-idle-label');

      if (label) {
        control.textContent = label;
      }
    });
  }

  document.addEventListener('submit', function (event) {
    var form = event.target;

    if (!form || form.tagName !== 'FORM') {
      return;
    }

    if (form.getAttribute('data-submitting') === 'true') {
      event.preventDefault();
      return;
    }

    form.setAttribute('data-submitting', 'true');
    lock(form);
  });

  function markDirty(event) {
    var cell = event.target && event.target.closest ? event.target.closest('tr.editable') : null;

    if (cell) {
      cell.classList.add('dirty');
    }
  }

  document.addEventListener('input', markDirty);
  document.addEventListener('change', markDirty);

  function initialsOf(name) {
    var parts = String(name).trim().split(/\s+/).filter(Boolean);

    if (parts.length === 0) {
      return '?';
    }

    if (parts.length === 1) {
      return parts[0].slice(0, 2).toUpperCase();
    }

    return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
  }

  document.addEventListener('change', function (event) {
    var select = event.target;

    if (!select || select.name !== 'assigneeUserId' || !select.closest) {
      return;
    }

    var wrap = select.closest('.assignee');
    var avatar = wrap ? wrap.querySelector('.avatar') : null;

    if (!avatar) {
      return;
    }

    if (!select.value) {
      avatar.textContent = '\u2013';
      avatar.classList.add('none');
      return;
    }

    avatar.textContent = initialsOf(select.options[select.selectedIndex].text);
    avatar.classList.remove('none');
  });

  function isNumberField(element) {
    return Boolean(element) && element.tagName === 'INPUT' && element.type === 'number';
  }

  document.addEventListener('keydown', function (event) {
    if (isNumberField(event.target) && ['-', '+', 'e', 'E'].indexOf(event.key) !== -1) {
      event.preventDefault();
    }
  });

  document.addEventListener('input', function (event) {
    var field = event.target;

    if (isNumberField(field) && field.value !== '' && Number(field.value) < 0) {
      field.value = '0';
    }
  });

  var toast = document.querySelector('.toast');

  if (toast) {
    var dismiss = function () {
      toast.style.transition = 'opacity 0.2s';
      toast.style.opacity = '0';
      window.setTimeout(function () { toast.remove(); }, 200);
    };

    var closer = toast.querySelector('.toast-close');

    if (closer) {
      closer.addEventListener('click', dismiss);
    }

    window.setTimeout(dismiss, 4500);
  }

  window.addEventListener('pageshow', function (event) {
    if (event.persisted) {
      Array.prototype.slice.call(document.querySelectorAll('form')).forEach(unlock);
    }
  });
})();
</script>
</body>
</html>
