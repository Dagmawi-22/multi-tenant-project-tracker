{{!< layout}}
<h1>Organizations</h1>
<p class="sub">You only ever see organizations you are a member of.</p>
{{#if error}}<div class="alert">{{error}}</div>{{/if}}

<div class="row">
  <div class="card">
    <h2>Your organizations</h2>
    {{#if organizations.length}}
      <div class="table-wrap">
        <table>
          <thead><tr><th>Name</th><th>Your role</th></tr></thead>
          <tbody>
          {{#each organizations}}
            <tr>
              <td><a href="/orgs/{{this.id}}">{{this.name}}</a></td>
              <td><span class="pill {{#unless this.isAdmin}}muted{{/unless}}">{{this.role}}</span></td>
            </tr>
          {{/each}}
          </tbody>
        </table>
      </div>
    {{else}}
      <p class="empty">No organizations yet. Create your first one alongside.</p>
    {{/if}}
  </div>

  <div class="card">
    <h2>Create an organization</h2>
    <p class="hint">You become its first admin.</p>
    <form method="post" action="/orgs" class="stack">
      <div class="field">
        <label for="org-name">Organization name</label>
        <input id="org-name" name="name" required>
      </div>
      <button type="submit">Create organization</button>
    </form>
  </div>
</div>
