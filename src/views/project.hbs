{{!< layout}}
<p class="crumb"><a href="/orgs">Organizations</a> &rsaquo; <a href="/orgs/{{organization.id}}">{{organization.name}}</a> &rsaquo; {{project.name}}</p>
<h1>{{project.name}}</h1>
<p class="sub">{{#if project.description}}{{project.description}}{{else}}No description.{{/if}}</p>
{{#if error}}<div class="alert">{{error}}</div>{{/if}}

<div class="card">
  <h2>Budget</h2>
  <div class="stats">
    <div>
      <div class="stat-label">Total budget</div>
      <div class="stat-value">{{budgetFormatted}} ETB</div>
    </div>
    <div>
      <div class="stat-label">Spent</div>
      <div class="stat-value">{{spentFormatted}} ETB</div>
    </div>
    <div>
      <div class="stat-label">Remaining</div>
      <div class="stat-value {{#if isOverBudget}}over{{/if}}">{{remainingFormatted}} ETB</div>
    </div>
  </div>
  <div class="meter {{#if isOverBudget}}over{{/if}}" style="margin-top:16px"><span style="width:{{percentUsed}}%"></span></div>
  <p class="note">Spent is the sum of the estimated cost of every task in this project.</p>
</div>

<div class="card">
  <h2>Tasks</h2>
  {{#if tasks.length}}
    <div class="table-wrap wide">
      <table>
        <thead>
          <tr>
            <th>Title</th>
            <th>Status</th>
            <th class="num">Estimated cost (ETB)</th>
            <th colspan="2"></th>
          </tr>
        </thead>
        <tbody>
        {{#each tasks}}
          <tr>
            <form method="post" action="/orgs/{{../organization.id}}/projects/{{../project.id}}/tasks/{{this.id}}" style="display:contents">
              <td><input name="title" value="{{this.title}}" aria-label="Task title" required></td>
              <td>
                <select name="status" aria-label="Task status">
                  <option value="todo" {{#if this.isTodo}}selected{{/if}}>todo</option>
                  <option value="in_progress" {{#if this.isInProgress}}selected{{/if}}>in progress</option>
                  <option value="done" {{#if this.isDone}}selected{{/if}}>done</option>
                </select>
              </td>
              <td class="num"><input class="num" name="estimatedCostEtb" type="number" min="0" step="0.01" value="{{this.estimatedCostEtb}}" aria-label="Estimated cost in ETB" required></td>
              <td class="num"><button class="secondary small" type="submit">Save</button></td>
            </form>
            <td>
              <div class="actions">
                <form method="post" action="/orgs/{{../organization.id}}/projects/{{../project.id}}/tasks/{{this.id}}/delete">
                  <button class="danger" type="submit">Delete</button>
                </form>
              </div>
            </td>
          </tr>
        {{/each}}
        </tbody>
      </table>
    </div>
  {{else}}
    <p class="empty">No tasks yet. Add the first one below.</p>
  {{/if}}
</div>

<div class="card">
  <h2>New task</h2>
  <form method="post" action="/orgs/{{organization.id}}/projects/{{project.id}}/tasks" class="inline-form">
    <div class="field">
      <label for="t-title">Title</label>
      <input id="t-title" name="title" required>
    </div>
    <div class="field field-sm">
      <label for="t-status">Status</label>
      <select id="t-status" name="status">
        <option value="todo">todo</option>
        <option value="in_progress">in progress</option>
        <option value="done">done</option>
      </select>
    </div>
    <div class="field field-md">
      <label for="t-cost">Estimated cost (ETB)</label>
      <input id="t-cost" name="estimatedCostEtb" type="number" min="0" step="0.01" value="0" required>
    </div>
    <button type="submit">Add task</button>
  </form>
</div>
